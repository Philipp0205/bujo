# Names only. Copy to .env and fill in, or export in your shell. Never commit real values.

# Listen address
PORT=3000
HOST=127.0.0.1

# Public address of this deployment (links in mail, origin check, Secure cookie on https)
BUJO_ORIGIN=
# SQLite file (default data/bujo.db)
BUJO_DB=
# Set to 1 behind a reverse proxy
BUJO_TRUST_PROXY=

# Email (both or neither; email is off without them)
RESEND_API_KEY=
MAIL_FROM=

# CalDAV (BASE and LISTS together, or neither for demo data)
BUJO_CALDAV_BASE=
BUJO_CALDAV_USER=
BUJO_CALDAV_PASSWORD=
BUJO_CALDAV_LISTS=
BUJO_CALDAV_EVENT_CALENDAR=

# OCR service for the evening scan (the scan feature answers 503 without it). Compose sets it for you.
# Local run, for example: http://127.0.0.1:8090
OCR_URL=

# LLM page reading, the only reader. These are set on the ocr service (compose passes them through), not on the app.
# Without BASE and KEY every scan fails.
# OpenAI-compatible gateway root, for example https://gateway.example/v1
OCR_LLM_BASE=
# Bearer key for the gateway. Page photos go to the gateway only.
OCR_LLM_KEY=
# Model name (default claude-haiku-5-5)
OCR_LLM_MODEL=
# Seconds to wait for the gateway (default 25; per request, and the app gives the whole scan 60 s)
OCR_LLM_TIMEOUT=
